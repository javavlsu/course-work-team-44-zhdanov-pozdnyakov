# ============================================================
#  Luckfox Image Builder — .gitignore
# ============================================================

# --- Luckfox Pico SDK (внешний, ~12 ГБ, со своим .git) ---
# В репозиторий НЕ кладём: это сторонний SDK от LuckfoxTECH.
# Клонируется отдельно (см. README): git clone https://github.com/LuckfoxTECH/luckfox-pico.git
luckfox-pico/

# На случай, если части SDK лежат вне своего каталога — игнор тяжёлых частей по имени:
sysdrv/
media/
output/
build/
.BoardConfig.mk

# --- Сгенерированные образы ---
*.img
*.img.*

# --- Java / Maven (backend) ---
target/
*.jar
*.war
*.class
!**/.mvn/wrapper/maven-wrapper.jar

# --- Node / Vite (frontend) ---
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Логи и временное ---
*.log
*.tmp
tmp/

# --- Секреты / окружение ---
.env
.env.local
.env.*.local
*.local

# --- IDE / редакторы ---
.idea/
*.iml
.vscode/
*.swp
*~

# --- ОС ---
.DS_Store
Thumbs.db
